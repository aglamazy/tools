rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - read own, write only via Admin SDK
    match /users/{uid} {
      // User can read their own document
      allow read: if request.auth != null && request.auth.uid == uid;
      // No client writes - tier and household managed server-side only
      allow write: if false;

      // Agent tasks & bots — user can read their own subcollections
      match /{subcol}/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid
                    && subcol in ['agentTasks', 'bots'];
        allow write: if false;
      }
    }

    // Households collection - read for members, write only via Admin SDK
    match /households/{householdId} {
      // Members can read their household (checked via custom claim)
      allow read: if request.auth != null
                  && request.auth.token.householdId == householdId;
      // No client writes - managed server-side only
      allow write: if false;
    }

    // Business shares collection - read for owner or recipient
    match /businessShares/{shareId} {
      allow read: if request.auth != null
                  && (resource.data.ownerUid == request.auth.uid
                      || resource.data.sharedWithUid == request.auth.uid);
      allow write: if false;
    }

    // Business share invitations - read for invitee or owner
    match /businessShareInvitations/{invitationId} {
      allow read: if request.auth != null
                  && (resource.data.inviteeEmail == request.auth.token.email
                      || resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    // Invitations collection - read for invitee or household owner
    match /invitations/{invitationId} {
      // Allow read if:
      // 1. User is authenticated AND
      // 2. Either the invitation is for their email OR they are the household owner
      allow read: if request.auth != null
                  && (
                    // Invitee can read invitation by email (needs to match their auth email)
                    resource.data.inviteeEmail == request.auth.token.email
                    // Or household owner can read their household's invitations
                    || (request.auth.token.householdId == resource.data.householdId
                        && request.auth.token.householdRole == 'owner')
                  );
      // No client writes - managed server-side only
      allow write: if false;
    }
  }
}
