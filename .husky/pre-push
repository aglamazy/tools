#!/bin/sh
# Activate the Node version pinned in .nvmrc (22) so the build matches CI/prod.
# The system `node` may be 18, which Next.js 16 rejects.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use --silent >/dev/null 2>&1 || nvm use --silent 22 >/dev/null 2>&1 || true
fi

echo "🔍 Running production build check (node $(node -v))..."
npm run build

if [ $? -ne 0 ]; then
  echo "❌ Build failed. Please fix the errors before pushing."
  exit 1
fi

echo "✅ Build check passed"
