rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Backup files - each user can only access their own backups
    match /backups/{userId}/{fileName} {
      // Allow read/write only if:
      // 1. User is authenticated
      // 2. User ID matches the path
      // 3. File size is under 2.5 MB (2621440 bytes)
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2621440;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
