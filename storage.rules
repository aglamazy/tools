rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Backup paths are namespaced by product variant (aglamazo/saliko) so a
    // misconfigured session for one product can never read/write the
    // other's backups — see app/config/variants.ts VARIANT and
    // app/services/cloudBackupService.ts (#248/#250).

    // Personal backup files - each user can only access their own backups
    match /backups/{variant}/{userId}/{fileName} {
      // Allow read/write only if:
      // 1. User is authenticated
      // 2. User ID matches the path
      // 3. File size is under 2.5 MB (2621440 bytes)
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2621440;
    }

    // Household backup files - members share access via custom claims
    match /backups/{variant}/households/{householdId}/{fileName} {
      // Allow read/write only if:
      // 1. User is authenticated
      // 2. User's householdId custom claim matches the path
      // 3. File size is under 2.5 MB (2621440 bytes)
      allow read: if request.auth != null
                  && request.auth.token.householdId == householdId;
      allow write: if request.auth != null
                   && request.auth.token.householdId == householdId
                   && request.resource.size < 2621440;
    }

    // Shared business backup files - both owner and recipient access via custom claims
    match /backups/{variant}/shared/{businessSyncId}/{fileName} {
      allow read: if request.auth != null
                  && businessSyncId in request.auth.token.sharedBusinesses;
      allow write: if request.auth != null
                   && businessSyncId in request.auth.token.sharedBusinesses
                   && request.resource.size < 2621440;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
