# Bootstrap owner email — grants admin API access before any user has owner tier in Firestore
# Set this to your email on first deploy, then promote yourself via the admin UI and remove it
OWNER_EMAIL=

# User tier segment (local = developer mode with all features)
# Options: local (default: freemium)
# Leave commented out for production (freemium tier)
NEXT_PUBLIC_SEGMENT=local

# Firebase Configuration (for cloud backup feature)
# Get these values from Firebase Console > Project Settings
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Telegram Bot (for PA / grocery assistant)
# Create bot via @BotFather, get token
TELEGRAM_BOT_TOKEN=
# Random secret for webhook validation (generate with: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# Shufersal proxy (Cloud Run in me-west1)
SHUFERSAL_PROXY_URL=
SHUFERSAL_PROXY_SECRET=

# Healthchecks.io
HEALTHCHECK_GROCERY_CRON_URL=

# Saliko Tier-3 server-side credential encryption key.
# AES-256-GCM, 32 bytes base64-encoded. Generate with:
#   openssl rand -base64 32
# REQUIRED for any Saliko deployment that lets logged-in users grant Tier-3
# consent (store credentials encrypted-at-rest server-side for unattended cron).
# Leaving unset is fine for Aglamazo / dev-without-Saliko, but any attempt to
# call saveCredentials on a consented user will fail with a clear error.
SALIKO_CREDS_ENCRYPTION_KEY=

# --- Saliko test/dry-run mode ---
# When 'true', every grocery checkout short-circuits before placing a real order
# (search / OTP / catalog reads still work). Use during the test-pipeline runs
# so the bot can drive real conversations without creating real Shufersal /
# Rexail orders. Leave unset (or anything other than 'true') in prod.
SALIKO_DRY_RUN=

# agents-observe — Medic service-call pipe (task #240)
# Full source of truth is .env.aglamazo; sync TOKEN to Vercel as SENSITIVE.
AGENTS_OBSERVE_INGEST_URL=https://cockpit.agents-head.com/api/service-call/ingest
AGENTS_OBSERVE_TOKEN=
AGENTS_OBSERVE_PROJECT_ID=aglamazo
# AGENTS_OBSERVE_ENV defaults to VERCEL_ENV; set to 'production' to force
